FROM eclipse-temurin:21-jre

WORKDIR /app

ARG JAR_FILE=target/*.jar
COPY ${JAR_FILE} app.jar

# Run as an unprivileged user; matches runAsUser in the Kubernetes manifests.
RUN useradd --system --uid 1001 --gid root appuser
USER 1001

EXPOSE 8081

# Without this the JVM sizes its heap from the host, not the container limit.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
