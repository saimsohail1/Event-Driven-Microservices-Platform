FROM nginx:alpine

# Copy static files
COPY index.html /usr/share/nginx/html/
COPY styles.css /usr/share/nginx/html/
COPY app.js /usr/share/nginx/html/

# Shared proxy directives, included by the rendered server block
COPY proxy-common.conf /etc/nginx/proxy-common.conf

# Templates in this directory are rendered with envsubst on startup, which is
# how the upstream service URLs are injected per environment.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Only substitute our own variables, so nginx's own $uri/$host survive envsubst.
ENV NGINX_ENVSUBST_FILTER="_SERVICE_URL$"

# Expose port 80
EXPOSE 80

# Nginx will start automatically
